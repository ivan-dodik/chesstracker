"""E2E tests: M18 — CSV export auth fix (get_current_user_for_web) + debounce."""

import os


def _read(path: str) -> str:
    with open(path) as f:
        return f.read()


def test_csv_export_uses_get_current_user_for_web():
    """M18.1 export.py uses get_current_user_for_web for cookie-based auth."""
    content = _read(os.path.join(os.path.dirname(__file__), "..", "app", "api", "export.py"))
    assert "get_current_user_for_web" in content, (
        "export endpoint should use get_current_user_for_web to support cookie auth"
    )


def test_export_tournament_csv_function_exists():
    """M18.2 export_service.py defines export_tournament_csv."""
    content = _read(
        os.path.join(os.path.dirname(__file__), "..", "app", "services", "export_service.py")
    )
    assert "export_tournament_csv" in content


def test_debounce_exists_in_tournament_list():
    """M18.3 Tournament list template has debounce logic for filter."""
    content = _read(
        os.path.join(
            os.path.dirname(__file__), "..", "app", "templates", "tournaments", "list.html"
        )
    )
    has_debounce = any(
        kw in content for kw in ["debounce", "setTimeout", "clearTimeout", "debounceTournamentsLoad"]
    )
    assert has_debounce, "Tournaments list template should contain debounce logic"