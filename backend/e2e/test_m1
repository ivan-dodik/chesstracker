"""E2E tests: M19 — Rating calculation service and rating history."""

import os


def _read(path: str) -> str:
    with open(path) as f:
        return f.read()


def test_rating_calculation_service_exists():
    """M19.1 rating_calculation_service.py defines calculate_elo_rating."""
    content = _read(
        os.path.join(
            os.path.dirname(__file__), "..", "app", "services", "rating_calculation_service.py"
        )
    )
    assert "calculate_elo_rating" in content
    assert "update_ratings_after_game" in content


def test_elo_formula_correct():
    """M19.2 ELO formula: E = 1/(1+10^((Rb-Ra)/400))."""
    content = _read(
        os.path.join(
            os.path.dirname(__file__), "..", "app", "services", "rating_calculation_service.py"
        )
    )
    assert "10 **" in content or "10**" in content, "Should use 10^((Rb-Ra)/400) formula"
    assert "400" in content, "ELO divisor should be 400"


def test_rating_history_model_has_tournament_id():
    """M19.3 RatingHistory model has tournament_id column."""
    content = _read(
        os.path.join(os.path.dirname(__file__), "..", "app", "models", "rating_history.py")
    )
    assert "tournament_id" in content


def test_player_detail_template_has_rating():
    """M19.4 Player detail template displays rating."""
    content = _read(
        os.path.join(os.path.dirname(__file__), "..", "app", "templates", "players", "detail.html")
    )
    assert "rating" in content.lower()