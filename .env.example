# User
UID=1000
GID=1000

# Database
DATABASE_URL=postgresql+asyncpg://ct_user:ct_password@db:5432/ct_database

# Security
SECRET_KEY=change-me-to-a-random-secret-key

# Telegram Bot (REQUIRED: replace with a real token from @BotFather to enable the bot)
# See TELEGRAM_BOT_SETUP.md for instructions
# TG_BOT_TOKEN=your-telegram-bot-token

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=["http://localhost:8000"]

# Backend
BACKEND_URL=http://backend:8000

# Debug
DEBUG=true
